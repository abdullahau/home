# yourdomain.com {
# 	root * /srv
# 	file_server
# 	encode gzip
#
# 	# HTML always revalidates; assets get a short cache window (no
# 	# cache-busting filenames here, so not longer). Matches ellie.wtf.
# 	@static path *.css *.js *.svg *.avif *.png *.jpg *.jpeg *.pdf *.woff *.woff2
# 	@html not path *.css *.js *.svg *.avif *.png *.jpg *.jpeg *.pdf *.woff *.woff2
