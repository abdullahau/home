abdullah.run, abdullah.diy {
	root * /srv
	file_server {
		precompressed zstd br gzip
	}
	encode zstd gzip

	# HTML always revalidates; assets get a short cache window (no
	# cache-busting filenames here, so not longer). Matches ellie.wtf.
	@static path *.css *.js *.svg *.avif *.png *.jpg *.jpeg *.pdf *.woff *.woff2
	@html not path *.css *.js *.svg *.avif *.png *.jpg *.jpeg *.pdf *.woff *.woff2
	header @static Cache-Control "public, max-age=14400, must-revalidate"
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Images/etc that live only on the VPS, outside the git repo
	# /media/<content-type>/<page-name>/photo.jpg -> media/<content-type>/<page-name>/photo.jpg
	handle_path /media/* {
		root * /media
		file_server
	}

	# Serve the styled 404 page while keeping the real status code.
	handle_errors {
		rewrite * /404.html
		file_server {
			precompressed zstd br gzip
		}
	}
}

# Canonical host: www.* redirects to the apex. Cloudflare holds CNAMEs for both.
# labels are right-to-left: labels.0=tld, labels.1=domain, labels.2=www
www.abdullah.run, www.abdullah.diy {
	redir https://{labels.1}.{labels.0}{uri} permanent
}

# Plex alias — raw relay on 32400 (vps/relay.sh) for Plex apps direct use
# Plex server settings (Settings > Network):
#   Custom server access URLs: https://plex.abdullah.run:443
#   Secure connections: Preferred (not Required — blocks Caddy's cert)
plex.abdullah.run {
	reverse_proxy 100.125.140.11:32400
}

jellyfin.abdullah.run {
	reverse_proxy 100.125.140.11:8096
}

navidrome.abdullah.run {
	reverse_proxy 100.125.140.11:4533
}

# textcast. Runs on this VPS, in ~/Developer/textcast, on the compose network
# this file's own stack creates — so it is reached by container name and never
# crosses the host, whose firewall rejects 8000 anyway.
#
# The app holds its own access control (TEXTCAST_REQUIRE_AUTH, one token, one
# cookie). Caddy adds no second gate: a bookmarklet posts a whole rendered
# article here, and basic auth would refuse it before the app ever saw it.
textcast.abdullah.run {
	reverse_proxy textcast-app:8000 {
		# The article body is the page's entire HTML, which is megabytes on a
		# news site. The default read timeout is generous, but say so.
		transport http {
			read_timeout 300s
		}
	}

	# A page of prose and a 30 MB Opus file. Compress the first, not the second.
	encode zstd gzip

	# The app marks its media `public, immutable`, which is right for a browser
	# and wrong in front of Cloudflare: the audio is behind the app's own login,
	# and `public` invites a shared cache to keep it. `>` replaces the header
	# rather than adding a second one — without it both went out and the answer
	# was whichever the client read first.
	@media path /media/*
	header @media >Cache-Control "private, max-age=31536000, immutable"
}

# Fallback bare-IP block — uncomment if the domains ever break.
